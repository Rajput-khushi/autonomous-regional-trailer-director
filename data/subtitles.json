      {"cue_id":"sub_raj_007_02","scene_id":"scene_07","in":"00:04:35.000","out":"00:04:39.000","text":"[raj placeholder] Sunita, ruk ja.","gloss_en":"Sunita, stop.","aligns_with":"sub_hi_007_02","meaning_tags":["warning","sibling_address"],"stereotype_flags":[],"native_review":"PENDING"},
