      {"cue_id":"sub_raj_006_02","scene_id":"scene_06","in":"00:03:55.000","out":"00:03:59.000","text":"[raj placeholder] Woh khat kit hain, Dharam?","gloss_en":"Where is that letter, Dharam?","aligns_with":"sub_hi_006_02","meaning_tags":["question","letter_reference","night_confrontation"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_006_03","scene_id":"scene_06","in":"00:04:02.000","out":"00:04:07.000","text":"[raj placeholder] Tau, main...","gloss_en":"Uncle, I...","aligns_with":"sub_hi_006_03","meaning_tags":["denial","emotional_distress"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_006_04","scene_id":"scene_06","in":"00:04:10.000","out":"00:04:15.000","text":"[raj placeholder] Baarh saal tak chhupayo! Kyun?","gloss_en":"Hidden for twelve years! Why?","aligns_with":"sub_hi_006_04","meaning_tags":["accusation","twelve_years_reference"],"stereotype_flags":[],"native_review":"PENDING"},

