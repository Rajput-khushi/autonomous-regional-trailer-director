      {"cue_id":"sub_bgc_008_04","scene_id":"scene_08","in":"00:05:45.000","out":"00:05:50.000","text":"[bgc placeholder] Tum dono bahut mazboot ho.","gloss_en":"You two are very strong.","aligns_with":"sub_hi_008_04","meaning_tags":["comfort","warmth"],"stereotype_flags":[],"native_review":"PENDING"}
    ],
    "raj": [
      {"cue_id":"sub_raj_001_01","scene_id":"scene_01","in":"00:00:09.000","out":"00:00:13.000","text":"[raj placeholder] Aao, chai le lo, thandi ho jaavegi.","gloss_en":"Come have some tea, it is getting cold.","aligns_with":"sub_hi_001_01","meaning_tags":["greeting","warmth","sibling_address"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_001_02","scene_id":"scene_01","in":"00:00:22.000","out":"00:00:26.000","text":"[raj placeholder] Bhaiyya, ek khat tha koi...","gloss_en":"Brother, there was some letter...","aligns_with":"sub_hi_001_02","meaning_tags":["mystery_hint","letter_reference","sibling_address"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_001_03","scene_id":"scene_01","in":"00:00:30.000","out":"00:00:34.000","text":"[raj placeholder] Kaun sa khat, Sunita?","gloss_en":"Which letter, Sunita?","aligns_with":"sub_hi_001_03","meaning_tags":["question","letter_reference"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_001_04","scene_id":"scene_01","in":"00:00:37.000","out":"00:00:41.000","text":"[raj placeholder] Chhod do abhi, Bhaiyya.","gloss_en":"Leave it for now, Brother.","aligns_with":"sub_hi_001_04","meaning_tags":["deflection","sibling_address"],"stereotype_flags":[],"native_review":"PENDING"},

      {"cue_id":"sub_raj_002_01","scene_id":"scene_02","in":"00:00:47.000","out":"00:00:51.000","text":"[raj placeholder] Bhaiyya, Tau ke aagey bahut bhalai dikhaavoh!","gloss_en":"Brother, you act so well-behaved in front of Uncle!","aligns_with":"sub_hi_002_01","meaning_tags":["teasing","humour","family_reference"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_002_02","scene_id":"scene_02","in":"00:00:51.000","out":"00:00:52.000","text":"[raj placeholder] Kya?","gloss_en":"What?","aligns_with":"sub_hi_002_02","meaning_tags":["surprise","humour"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_002_03","scene_id":"scene_02","in":"00:00:52.000","out":"00:00:56.000","text":"[raj placeholder] Tau ne dekh'yo tum girya'a hasste-hasste!","gloss_en":"Uncle saw you fall over laughing!","aligns_with":"sub_hi_002_03","meaning_tags":["teasing","humour","family_reference"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_002_04","scene_id":"scene_02","in":"00:01:00.000","out":"00:01:05.000","text":"[raj placeholder] Chhod bhi de, Chachi aavey se.","gloss_en":"Let it go, Chachi is coming.","aligns_with":"sub_hi_002_04","meaning_tags":["deflection","family_reference"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_002_05","scene_id":"scene_02","in":"00:01:06.000","out":"00:01:09.000","text":"[raj placeholder] Yeh sab chhod'o, chai peeyo.","gloss_en":"Forget all this, drink your tea.","aligns_with":"sub_hi_002_05","meaning_tags":["advice","warmth","deflection"],"stereotype_flags":[],"native_review":"PENDING"},

      {"cue_id":"sub_raj_003_01","scene_id":"scene_03","in":"00:01:26.000","out":"00:01:30.000","text":"[raj placeholder] Sunita, Tau kehva'a tha ghar mein ek khat hai.","gloss_en":"Sunita, Uncle had said there is a letter in the house.","aligns_with":"sub_hi_003_01","meaning_tags":["letter_reference","uncle_reference","mystery_hint"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_003_02","scene_id":"scene_03","in":"00:01:31.000","out":"00:01:36.000","text":"[raj placeholder] Kaun sa khat, Chachi?","gloss_en":"Which letter, Chachi?","aligns_with":"sub_hi_003_02","meaning_tags":["question","letter_reference"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_003_03","scene_id":"scene_03","in":"00:01:37.000","out":"00:01:41.000","text":"[raj placeholder] Woh khat jo kabhi milyo nahi...","gloss_en":"The letter that never arrived...","aligns_with":"sub_hi_003_03","meaning_tags":["mystery_hint","letter_reference"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_003_04","scene_id":"scene_03","in":"00:01:42.000","out":"00:01:47.000","text":"[raj placeholder] Chachi, is ghar mein kuch toh chhupyo se.","gloss_en":"Chachi, something is hidden in this house.","aligns_with":"sub_hi_003_04","meaning_tags":["mystery_hint","determination"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_003_05","scene_id":"scene_03","in":"00:01:52.000","out":"00:01:57.000","text":"[raj placeholder] Beta, kuch baatein chup mein rahvey.","gloss_en":"Child, some things remain in silence.","aligns_with":"sub_hi_003_05","meaning_tags":["philosophical","warning"],"stereotype_flags":[],"native_review":"PENDING"},

      {"cue_id":"sub_raj_004_01","scene_id":"scene_04","in":"00:02:13.000","out":"00:02:17.000","text":"[raj placeholder] Chitthi kit hain, Bhaiyya?","gloss_en":"Where is the letter, Brother?","aligns_with":"sub_hi_004_01","meaning_tags":["question","missing_letter","sibling_address"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_004_02","scene_id":"scene_04","in":"00:02:20.000","out":"00:02:25.000","text":"[raj placeholder] Main nahi jaanu koi chitthi.","gloss_en":"I do not know of any letter.","aligns_with":"sub_hi_004_02","meaning_tags":["denial","letter_reference"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_004_03","scene_id":"scene_04","in":"00:02:32.000","out":"00:02:37.000","text":"[raj placeholder] Tau kehvo tha tum jano ho!","gloss_en":"Uncle said you know about it!","aligns_with":"sub_hi_004_03","meaning_tags":["accusation","uncle_reference","letter_reference"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_004_04","scene_id":"scene_04","in":"00:02:40.000","out":"00:02:44.000","text":"[raj placeholder] Tau galat bol ryo hain.","gloss_en":"Uncle is saying it wrong.","aligns_with":"sub_hi_004_04","meaning_tags":["denial","uncle_reference"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_004_05","scene_id":"scene_04","in":"00:02:46.000","out":"00:02:51.000","text":"[raj placeholder] Main sach jaanna chahun, Bhaiyya!","gloss_en":"I want to know the truth, Brother!","aligns_with":"sub_hi_004_05","meaning_tags":["determination","truth_seeking","sibling_address"],"stereotype_flags":[],"native_review":"PENDING"},
      {"cue_id":"sub_raj_004_06","scene_id":"scene_04","in":"00:02:52.000","out":"00:02:55.000","text":"[raj placeholder] Yeh ghar ki baat hain.","gloss_en":"This is a matter of the family.","aligns_with":"sub_hi_004_06","meaning_tags":["deflection","family_reference"],"stereotype_flags":[],"native_review":"PENDING"},

      {"cue_id":"sub_raj_005_01","scene_id":"scene_05","in":"00:03:01.000","out":"00:03:05.000","text":"[raj placeholder] Harmonium andar kya rakhyo kisne?","gloss_en":"What has someone placed inside the harmonium?","aligns_with":"sub_hi_005_01","meaning_tags":["discovery","question","harmonium_reference"],"stereotype_flags":[],"native_review":"PENDING"},
