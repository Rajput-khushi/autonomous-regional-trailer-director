  "tracks": {
    "hi": [
      {"cue_id":"sub_hi_001_01","scene_id":"scene_01","in":"00:00:09.000","out":"00:00:13.000","text":"Aao, chai pi lo, thandi ho rahi hai.","gloss_en":"Come have some tea, it is getting cold.","meaning_tags":["greeting","warmth","sibling_address"],"source_line_id":"line_001_01"},
      {"cue_id":"sub_hi_001_02","scene_id":"scene_01","in":"00:00:22.000","out":"00:00:26.000","text":"Bhaiya, ek khat tha koi...","gloss_en":"Brother, there was some letter...","meaning_tags":["mystery_hint","letter_reference","sibling_address"],"source_line_id":"line_001_02"},
      {"cue_id":"sub_hi_001_03","scene_id":"scene_01","in":"00:00:30.000","out":"00:00:34.000","text":"Kaunsa khat, Sunita?","gloss_en":"Which letter, Sunita?","meaning_tags":["question","letter_reference"],"source_line_id":"line_001_03"},
      {"cue_id":"sub_hi_001_04","scene_id":"scene_01","in":"00:00:37.000","out":"00:00:41.000","text":"Chhod do abhi, Bhaiya.","gloss_en":"Leave it for now, Brother.","meaning_tags":["deflection","sibling_address"],"source_line_id":"line_001_04"},

      {"cue_id":"sub_hi_002_01","scene_id":"scene_02","in":"00:00:47.000","out":"00:00:51.000","text":"Bhaiya, Tau ke samne tum bahut shareef bante ho!","gloss_en":"Brother, you act so well-behaved in front of Uncle!","meaning_tags":["teasing","humour","family_reference"],"source_line_id":"line_002_01"},
      {"cue_id":"sub_hi_002_02","scene_id":"scene_02","in":"00:00:51.000","out":"00:00:52.000","text":"Kya?","gloss_en":"What?","meaning_tags":["surprise","humour"],"source_line_id":"line_002_02"},
      {"cue_id":"sub_hi_002_03","scene_id":"scene_02","in":"00:00:52.000","out":"00:00:56.000","text":"Tau ne dekha tha tum gire the hastte-hastte!","gloss_en":"Uncle saw you fall over laughing!","meaning_tags":["teasing","humour","family_reference"],"source_line_id":"line_002_03"},
      {"cue_id":"sub_hi_002_04","scene_id":"scene_02","in":"00:01:00.000","out":"00:01:05.000","text":"Chhod bhi do, Chachi aa rahi hai.","gloss_en":"Let it go, Chachi is coming.","meaning_tags":["deflection","family_reference"],"source_line_id":"line_002_04"},
      {"cue_id":"sub_hi_002_05","scene_id":"scene_02","in":"00:01:06.000","out":"00:01:09.000","text":"Yeh sab chhodo, chai peeyo.","gloss_en":"Forget all this, drink your tea.","meaning_tags":["advice","warmth","deflection"],"source_line_id":"line_002_05"},

      {"cue_id":"sub_hi_003_01","scene_id":"scene_03","in":"00:01:26.000","out":"00:01:30.000","text":"Sunita, Tau ne kaha tha ki ghar mein ek khat hai.","gloss_en":"Sunita, Uncle had said there is a letter in the house.","meaning_tags":["letter_reference","uncle_reference","mystery_hint"],"source_line_id":"line_003_01"},
      {"cue_id":"sub_hi_003_02","scene_id":"scene_03","in":"00:01:31.000","out":"00:01:36.000","text":"Kaun sa khat, Chachi?","gloss_en":"Which letter, Chachi?","meaning_tags":["question","letter_reference"],"source_line_id":"line_003_02"},
      {"cue_id":"sub_hi_003_03","scene_id":"scene_03","in":"00:01:37.000","out":"00:01:41.000","text":"Woh khat jo kabhi mila nahi...","gloss_en":"The letter that never arrived...","meaning_tags":["mystery_hint","letter_reference"],"source_line_id":"line_003_03"},
      {"cue_id":"sub_hi_003_04","scene_id":"scene_03","in":"00:01:42.000","out":"00:01:47.000","text":"Chachi, kuch toh chhupa hai is ghar mein.","gloss_en":"Chachi, something is hidden in this house.","meaning_tags":["mystery_hint","determination"],"source_line_id":"line_003_04"},
      {"cue_id":"sub_hi_003_05","scene_id":"scene_03","in":"00:01:52.000","out":"00:01:57.000","text":"Beta, kuch baatein khaamoshi mein rehti hain.","gloss_en":"Child, some things remain in silence.","meaning_tags":["philosophical","warning"],"source_line_id":"line_003_05"},

      {"cue_id":"sub_hi_004_01","scene_id":"scene_04","in":"00:02:13.000","out":"00:02:17.000","text":"Chitthi kahan hai, Bhaiya?","gloss_en":"Where is the letter, Brother?","meaning_tags":["question","missing_letter","sibling_address"],"source_line_id":"line_004_01"},
      {"cue_id":"sub_hi_004_02","scene_id":"scene_04","in":"00:02:20.000","out":"00:02:25.000","text":"Main nahi jaanta koi chitthi.","gloss_en":"I do not know of any letter.","meaning_tags":["denial","letter_reference"],"source_line_id":"line_004_02"},
      {"cue_id":"sub_hi_004_03","scene_id":"scene_04","in":"00:02:32.000","out":"00:02:37.000","text":"Tau ne kaha tha tum jaante ho!","gloss_en":"Uncle said you know about it!","meaning_tags":["accusation","uncle_reference","letter_reference"],"source_line_id":"line_004_03"},
      {"cue_id":"sub_hi_004_04","scene_id":"scene_04","in":"00:02:40.000","out":"00:02:44.000","text":"Tau galat bol rahe hain.","gloss_en":"Uncle is saying it wrong.","meaning_tags":["denial","uncle_reference"],"source_line_id":"line_004_04"},
      {"cue_id":"sub_hi_004_05","scene_id":"scene_04","in":"00:02:46.000","out":"00:02:51.000","text":"Main sach jaanna chahti hoon, Bhaiya!","gloss_en":"I want to know the truth, Brother!","meaning_tags":["determination","truth_seeking","sibling_address"],"source_line_id":"line_004_05"},
      {"cue_id":"sub_hi_004_06","scene_id":"scene_04","in":"00:02:52.000","out":"00:02:55.000","text":"Yeh ghar ki baat hai.","gloss_en":"This is a matter of the family.","meaning_tags":["deflection","family_reference"],"source_line_id":"line_004_06"},

      {"cue_id":"sub_hi_005_01","scene_id":"scene_05","in":"00:03:01.000","out":"00:03:05.000","text":"Harmonium ke andar kya rakh diya kisne?","gloss_en":"What has someone placed inside the harmonium?","meaning_tags":["discovery","question","harmonium_reference"],"source_line_id":"line_005_01"},
      {"cue_id":"sub_hi_005_02","scene_id":"scene_05","in":"00:03:07.000","out":"00:03:12.000","text":"Ek band lifafa! Yahan chhupa tha!","gloss_en":"A sealed envelope! It was hidden here!","meaning_tags":["discovery","envelope_found","shock"],"source_line_id":"line_005_02"},
      {"cue_id":"sub_hi_005_03","scene_id":"scene_05","in":"00:03:15.000","out":"00:03:20.000","text":"Main zaroor padhungi yeh.","gloss_en":"I will definitely read this.","meaning_tags":["determination","letter_reference"],"source_line_id":"line_005_03"},
      {"cue_id":"sub_hi_005_04","scene_id":"scene_05","in":"00:03:22.000","out":"00:03:27.000","text":"Yeh khat kiska hai?","gloss_en":"Whose letter is this?","meaning_tags":["question","letter_reference"],"source_line_id":"line_005_04"},

      {"cue_id":"sub_hi_006_01","scene_id":"scene_06","in":"00:03:38.000","out":"00:03:42.000","text":"Aadhee raat ko kyun uthaya mujhe, Tau?","gloss_en":"Why did you wake me at midnight, Uncle?","meaning_tags":["question","night_confrontation","uncle_address"],"source_line_id":"line_006_01"},
      {"cue_id":"sub_hi_006_02","scene_id":"scene_06","in":"00:03:55.000","out":"00:03:59.000","text":"Woh khat kahan hai, Dharam?","gloss_en":"Where is that letter, Dharam?","meaning_tags":["question","letter_reference","night_confrontation"],"source_line_id":"line_006_02"},
      {"cue_id":"sub_hi_006_03","scene_id":"scene_06","in":"00:04:02.000","out":"00:04:07.000","text":"Tau, main...","gloss_en":"Uncle, I...","meaning_tags":["denial","emotional_distress"],"source_line_id":"line_006_03"},
      {"cue_id":"sub_hi_006_04","scene_id":"scene_06","in":"00:04:10.000","out":"00:04:15.000","text":"Baarh saal tak chhupaya! Kyun?","gloss_en":"Hidden for twelve years! Why?","meaning_tags":["accusation","twelve_years_reference"],"source_line_id":"line_006_04"},

      {"cue_id":"sub_hi_007_01","scene_id":"scene_07","in":"00:04:26.000","out":"00:04:30.000","text":"Main padhungi yeh khat.","gloss_en":"I will read this letter.","meaning_tags":["determination","letter_reference"],"source_line_id":"line_007_01"},
      {"cue_id":"sub_hi_007_02","scene_id":"scene_07","in":"00:04:35.000","out":"00:04:39.000","text":"Sunita, ruk.","gloss_en":"Sunita, stop.","meaning_tags":["warning","sibling_address"],"source_line_id":"line_007_02"},
      {"cue_id":"sub_hi_007_03","scene_id":"scene_07","in":"00:04:42.000","out":"00:04:47.000","text":"Dharam, ab nahi ruk sakta.","gloss_en":"Dharam, it cannot be stopped now.","meaning_tags":["resignation","confrontation"],"source_line_id":"line_007_03"},
      {"cue_id":"sub_hi_007_04","scene_id":"scene_07","in":"00:04:50.000","out":"00:04:54.000","text":"Haan... woh sach tha jo usme likha tha.","gloss_en":"Yes... what was written in it was the truth.","meaning_tags":["confession","truth_reveal","identity_confirmation"],"source_line_id":"line_007_04"},
      {"cue_id":"sub_hi_007_05","scene_id":"scene_07","in":"00:05:00.000","out":"00:05:06.000","text":"Tau... tum mere...","gloss_en":"Uncle... you are my...","meaning_tags":["revelation","identity_question","shock"],"source_line_id":"line_007_05"},

      {"cue_id":"sub_hi_008_01","scene_id":"scene_08","in":"00:05:15.000","out":"00:05:19.000","text":"Sunita...","gloss_en":"Sunita...","meaning_tags":["emotional_distress","sibling_address"],"source_line_id":"line_008_01"},
      {"cue_id":"sub_hi_008_02","scene_id":"scene_08","in":"00:05:21.000","out":"00:05:26.000","text":"Bhaiya, main maafi maangti hoon.","gloss_en":"Brother, I am sorry.","meaning_tags":["reconciliation","apology","sibling_address"],"source_line_id":"line_008_02"},
      {"cue_id":"sub_hi_008_03","scene_id":"scene_08","in":"00:05:32.000","out":"00:05:37.000","text":"Yeh dard dono ne jhela hai.","gloss_en":"We both have borne this pain.","meaning_tags":["empathy","family_reference"],"source_line_id":"line_008_03"},
      {"cue_id":"sub_hi_008_04","scene_id":"scene_08","in":"00:05:45.000","out":"00:05:50.000","text":"Tum dono bahut strong ho.","gloss_en":"You two are very strong.","meaning_tags":["comfort","warmth"],"source_line_id":"line_008_04"}
