{
  "$defs": {
    "DialectCue": {
      "description": "One cue in a dialect (bgc / raj) subtitle track — DATA_SPEC.md §7.",
      "properties": {
        "cue_id": {
          "title": "Cue Id",
          "type": "string"
        },
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "in": {
          "title": "In",
          "type": "string"
        },
        "out": {
          "title": "Out",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "gloss_en": {
          "default": "",
          "title": "Gloss En",
          "type": "string"
        },
        "aligns_with": {
          "title": "Aligns With",
          "type": "string"
        },
        "meaning_tags": {
          "items": {
            "type": "string"
          },
          "title": "Meaning Tags",
          "type": "array"
        },
        "stereotype_flags": {
          "items": {
            "type": "string"
          },
          "title": "Stereotype Flags",
          "type": "array"
        },
        "native_review": {
          "$ref": "#/$defs/NativeReviewStatus",
